{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.4.1",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "author": "Alan_m-12",
  "homepage_url": "https://github.com/Alan1112223331/ntulearn-bilingual-subtitles",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.kaltura.com/*",
    "https://*.ntu.edu.sg/*",
    "https://translate.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.kaltura.com/*",
        "https://*.ntu.edu.sg/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.kaltura.com/*",
        "https://*.ntu.edu.sg/*"
      ],
      "js": [
        "src/shared.js",
        "src/parsers.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "toggle-subtitles": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdToggle__"
    },
    "cycle-mode": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_cmdCycleMode__"
    }
  }
}
